{
  "name": "@d3-polytree/interactive-viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive polytree viewer (zoom, pan, search)",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/viewer": "workspace:*",
    "@d3-polytree/core": "workspace:*",
    "@d3-polytree/side-tabs": "workspace:*",
    "@d3-polytree/search-panel": "workspace:*"
  }
}
