{
  "name": "@d3-polytree/interactive-viewer",
  "version": "0.5.2",
  "description": "Interactive polytree viewer (zoom, pan, search)",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": "./dist/interactive-viewer.umd.js",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && sass src/style.scss dist/style.css --no-source-map --style=compressed --silence-deprecation=import",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/viewer": "workspace:*",
    "@d3-polytree/core": "workspace:*",
    "@d3-polytree/canvas": "workspace:*",
    "eventemitter3": "^5.0.1"
  },
  "unpkg": "./dist/interactive-viewer.umd.js",
  "jsdelivr": "./dist/interactive-viewer.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/interactive-viewer"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/v2/packages/interactive-viewer#readme",
  "publishConfig": {
    "access": "public"
  }
}
