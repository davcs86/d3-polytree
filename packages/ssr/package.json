{
  "name": "@d3-polytree/ssr",
  "version": "0.2.4",
  "description": "Server-side rendering: turn a .pfdn document into a static SVG string in Node (deterministic, no browser) for the d3-polytree v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/canvas": "workspace:*",
    "@d3-polytree/core": "workspace:*",
    "@d3-polytree/viewer": "workspace:*",
    "jsdom": "25.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/ssr"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/main/packages/ssr#readme",
  "publishConfig": {
    "access": "public"
  }
}
