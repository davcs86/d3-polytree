{
  "name": "@d3-polytree/layout",
  "version": "0.1.0",
  "description": "Framework-free layered (Sugiyama) auto-layout for d3-polytree diagrams — pure solver + Worker host",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/layout"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/main/packages/layout#readme",
  "publishConfig": {
    "access": "public"
  }
}
