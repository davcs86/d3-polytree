{
  "name": "@d3-polytree/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Static polytree viewer (no interaction)",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": "./dist/viewer.umd.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/core": "workspace:*"
  },
  "unpkg": "./dist/viewer.umd.js",
  "jsdelivr": "./dist/viewer.umd.js"
}
