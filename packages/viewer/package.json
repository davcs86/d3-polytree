{
  "name": "@d3-polytree/viewer",
  "version": "0.2.3",
  "description": "Static polytree viewer (no interaction)",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": "./dist/viewer.umd.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/core": "workspace:*"
  },
  "peerDependencies": {
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "d3-transition": "^3.0.0",
    "d3-scale": "^4.0.0",
    "d3-axis": "^3.0.0",
    "d3-drag": "^3.0.0"
  },
  "devDependencies": {
    "eventemitter3": "^5.0.1"
  },
  "unpkg": "./dist/viewer.umd.js",
  "jsdelivr": "./dist/viewer.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/main/packages/viewer#readme",
  "publishConfig": {
    "access": "public"
  }
}
