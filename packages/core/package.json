{
  "name": "@d3-polytree/core",
  "version": "0.5.0",
  "description": "Core diagram engine for the d3-polytree v2 ecosystem (draw/features/modelling) — carved from core-v2beta in B3",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/canvas": "workspace:*",
    "@d3-polytree/layout": "workspace:*",
    "@d3-polytree/pfdn-moddle": "workspace:*",
    "didi": "^9.0.0",
    "eventemitter3": "^5.0.1"
  },
  "peerDependencies": {
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "d3-transition": "^3.0.0",
    "d3-scale": "^4.0.0",
    "d3-axis": "^3.0.0",
    "d3-drag": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "@types/d3-zoom": "^3.0.8",
    "d3-transition": "^3.0.0",
    "@types/d3-transition": "^3.0.9",
    "d3-scale": "^4.0.0",
    "d3-axis": "^3.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-axis": "^3.0.6",
    "d3-drag": "^3.0.0",
    "@types/d3-drag": "^3.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  }
}
