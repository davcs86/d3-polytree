{
  "name": "@d3-polytree/properties-panel",
  "version": "0.0.0",
  "description": "Editor element-properties panel (de-jQuery-ed) for the d3-polytree v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && sass src/style/style.scss dist/style.css --no-source-map --style=compressed --silence-deprecation=import",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  }
}
