{
  "name": "@d3-polytree/icons-amazon",
  "version": "0.1.3",
  "description": "AWS icon pack + icon-pack convention reference for the d3-polytree v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-icons.mjs",
    "build": "node scripts/generate-icons.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/icons-amazon"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/v2/packages/icons-amazon#readme",
  "publishConfig": {
    "access": "public"
  }
}
