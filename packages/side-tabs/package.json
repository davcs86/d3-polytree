{
  "name": "@d3-polytree/side-tabs",
  "version": "0.0.0",
  "description": "Collapsible tabbed side panel feature for the d3-polytree v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && sass src/style.scss dist/style.css --no-source-map --style=compressed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/canvas": "workspace:*",
    "eventemitter3": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/side-tabs"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/v2/packages/side-tabs#readme",
  "publishConfig": {
    "access": "public"
  }
}
