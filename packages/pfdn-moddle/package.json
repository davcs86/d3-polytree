{
  "name": "@d3-polytree/pfdn-moddle",
  "version": "0.2.1",
  "description": "Read/write Process Flow Diagram Notation (.pfdn) documents — a moddle model for the d3-polytree v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-pfdn.mjs",
    "build": "node scripts/generate-pfdn.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "moddle": "^7.0.0",
    "moddle-xml": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/pfdn-moddle"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/main/packages/pfdn-moddle#readme",
  "publishConfig": {
    "access": "public"
  }
}
