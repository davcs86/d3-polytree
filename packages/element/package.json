{
  "name": "@d3-polytree/element",
  "version": "0.2.0",
  "description": "<d3-polytree-editor> custom element (shadow DOM, form-associated) wrapping the polytree editor",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": "./dist/element.umd.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/element.umd.js"
  ],
  "scripts": {
    "build": "node scripts/generate-styles.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@d3-polytree/editor": "workspace:*",
    "@d3-polytree/interactive-viewer": "workspace:*",
    "@d3-polytree/viewer": "workspace:*"
  },
  "unpkg": "./dist/element.umd.js",
  "jsdelivr": "./dist/element.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/element"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/main/packages/element#readme",
  "publishConfig": {
    "access": "public"
  }
}
