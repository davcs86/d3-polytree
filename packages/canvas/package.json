{
  "name": "@d3-polytree/canvas",
  "version": "0.1.0",
  "description": "Base SVG canvas toolbox (Canvas, ElementRegistry, ElementBuilder, SVG export) for the d3-polytree v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "ids": "^1.0.5"
  },
  "peerDependencies": {
    "d3-selection": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-selection": "^3.0.11",
    "d3-selection": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/davcs86/d3-polytree/tree/v2/packages/canvas#readme",
  "publishConfig": {
    "access": "public"
  }
}
