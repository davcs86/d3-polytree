{
  "name": "d3-polytree-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the @d3-polytree/* v2 ecosystem",
  "license": "MIT",
  "author": "David Castillo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davcs86/d3-polytree.git"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @d3-polytree/storybook storybook",
    "build-storybook": "pnpm --filter @d3-polytree/storybook build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/preflight-trusted-publishing.mjs && turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "sass": "^1.77.8"
  }
}
